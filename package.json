{
  "name": "@datocms/release-toolchain",
  "version": "1.3.0",
  "private": true,
  "description": "The release script every DatoCMS repository runs. Installed by git tag, never published to npm.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datocms/release-toolchain.git"
  },
  "bin": {
    "release-toolchain": "src/bin.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/bin.mjs",
    "test": "node --test test/*.test.mjs",
    "changeset": "changeset",
    "release": "node toolchain/release.mjs"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0"
  },
  "peerDependencies": {
    "@changesets/cli": ">=3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
